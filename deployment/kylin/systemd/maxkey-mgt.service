[Unit]
Description=MaxKey Mgt Console (管理端) 9526
Documentation=https://www.maxkey.top
# After 只表达"启动顺序"：等 portal 与数据库就绪后再起本服务。
After=network-online.target maxkey-portal.service kingbase.service
Wants=network-online.target

# 这里**不能用 Requires=maxkey-portal.service**，踩过坑：
#
#   Requires 表达的是"强依赖其存活"，后果有三个，都是坏事：
#     1. `systemctl stop maxkey-portal` 会连带停掉 mgt ——
#        只想重启认证中心时，管理端被静默带走。
#     2. `systemctl restart maxkey-portal` 期间 mgt 被判 Dependency failed，
#        且 **不会自动恢复**，必须手工 reset-failed + start。
#     3. portal 启动失败时 mgt 根本起不来，两个服务互相拖累。
#
#   而管理端对认证中心的真实依赖只是"启动时它已就绪"（CAS 登录需要），
#   运行期两者各自独立；portal 短暂不可用时 mgt 自身仍能提供配置界面。
#   所以用 After 表达顺序即可，不声明 Requires。
#
#   若现场确实要求两者严格同生共死，可自行加 Requires，但要清楚上面三点代价。

[Service]
Type=forking
PIDFile=/opt/maxkey/run/maxkey-mgt.pid
ExecStart=/opt/maxkey/bin/maxkeyctl.sh start mgt
ExecStop=/opt/maxkey/bin/maxkeyctl.sh stop mgt
RemainAfterExit=yes

TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

User=maxkey
Group=maxkey
WorkingDirectory=/opt/maxkey

# 环境变量统一由 maxkeyctl.sh 从 conf/maxkey.env 加载，避免两套解析规则
# 例外：数据库口令走独立密钥文件（仅一行 DATABASE_PWD=...，权限 600 root:root）
EnvironmentFile=-/etc/maxkey/maxkey-secret.env
Environment="LANG=zh_CN.UTF-8"

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/maxkey/logs /opt/maxkey/run /opt/maxkey/maxkey_mgt/logs

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
