# ===========================================================================
#  数据库口令密钥文件 —— 示例模板
#
#  这是**模板**，不要直接改本文件后提交。正确用法：
#
#    sudo mkdir -p /etc/maxkey
#    sudo cp maxkey-secret.env.example /etc/maxkey/maxkey-secret.env
#    sudo vi /etc/maxkey/maxkey-secret.env          # 填入真实口令
#    sudo chown root:root /etc/maxkey/maxkey-secret.env
#    sudo chmod 600 /etc/maxkey/maxkey-secret.env
#
#  systemd 单元已引用该路径（EnvironmentFile=-/etc/maxkey/maxkey-secret.env），
#  前缀 "-" 表示文件不存在时不报错，由 maxkeyctl.sh 在启动前显式拦截并提示。
#
#  为什么单独放这里、而不是写进 conf/maxkey.env：
#    conf/maxkey.env 是**被 git 跟踪的模板**，若在其中填明文口令，
#    git add 就会把口令永久写进提交历史，后续即使删除也仍可被翻出。
#    本文件不在仓库内（位于 /etc/maxkey/），从根上避免该风险。
#
#  文件格式要求（systemd EnvironmentFile 语法，与 shell 有细微差异）：
#    * 每行 KEY=VALUE，不要写 export
#    * 值可以用单引号包裹；systemd 会像 POSIX shell 一样剥掉引号，
#      因此 DATABASE_PWD='p@ss' 解析结果是 p@ss 而非 'p@ss'
#    * 口令含 $、反引号、反斜杠、双引号时，**必须用单引号**包裹，
#      否则会被当作变量展开或转义（systemd 对双引号值会做转义处理）
#    * 本文件只需要一行，不要放其它配置
# ===========================================================================

# 数据库口令。若含 $ ` \ " 等特殊字符，请用单引号包裹：
DATABASE_PWD='请替换为实际口令'

# ---------------------------------------------------------------------------
# JWT 签名密钥（4.2.0 起必须提供，否则 maxkeyctl.sh 拒绝启动）
#
# 原先是 512 字符明文写死在两个 properties 里 —— 拿到 jar 就能伪造任意用户
# token。现改为从本文件注入，portal 与 mgt 必须使用**同一个**值。
#
# 不要手工编一个短串：
#   * 长度必须 >= 64 字节（HS512 下限），否则启动抛 WeakKeyException
#   * 太简单会让 token 可被爆破
#
# 正确做法：让 install.sh 自动生成（512 字符随机 ASCII）：
#     sudo ./install.sh --profile <环境名> --force-reinstall
# 或手边没有安装脚本时生成一个：
#     printf 'JWT_SECRET=%s\n' \
#       "$(LC_ALL=C tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c 512)" \
#       | sudo tee -a /etc/maxkey/maxkey-secret.env
#
# ⚠️ 换这个值会让所有已登录会话立即失效（token 签名校验不过）。
#    换环境时应当换；日常升级不要换。
JWT_SECRET='请替换为 512 字符随机串，或用 install.sh 自动生成'

# 仅当数据库口令与 MaxKey 不同名用户等特殊场景，才需要额外覆盖下面两项
# （正常情况下 conf/maxkey.env 中的 DATABASE_USER / DATABASE_URL 已够用）
# DATABASE_USER='maxkey'
