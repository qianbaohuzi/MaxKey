############################################################################
#  MaxKey 部署环境变量（麒麟 / 通用 Linux）
#
#  放置位置: <发布根>/conf/maxkey.env
#  由 bin/maxkeyctl.sh 自动 source；systemd 单元会显式指定该文件。
#
#  说明:
#    * Spring Boot 的属性占位符形如 ${DATABASE_PWD:maxkey}，
#      这里的 shell 变量会被同名环境变量覆盖，优先顺序为：
#          shell 环境变量 > 本文件 > 代码内默认值
#    * 修改本文件后需 restart 生效
############################################################################

# ------------------------------------------------------------------ 基本 --
# 站点域名。只写主域部分，不要写 http:// 或端口。
# sso.<SERVER_DOMAIN> 由程序内部拼接（见 application-maxkey.properties:35）
SERVER_DOMAIN=example.gov.cn

# 对外暴露的协议与端口（经 nginx 反代时通常为 http + 80）
# 若前端用 https 反代，改成 https / 443
MAXKEY_SCHEME=http

# ------------------------------------------------------------------ 端口 --
# 后端 HTTP 端口（只监听本机，由 nginx 反代）
PORTAL_PORT=9527
MGT_PORT=9526

# ----------------------------------------------------------------- 数据库 --
# 驱动: com.kingbase8.Driver / com.mysql.cj.jdbc.Driver
DATABASE_DRIVER=com.kingbase8.Driver
# 注意：JDBC URL 含 & 和 ?，**必须用单引号包裹**。
# 裸写会让 bash 把 & 当成“后台执行”分隔符，DATABASE_URL 变成空值，
# 后面的 useUnicode=true 被当成命令执行（报 command not found），
# 最终应用静默回落到内置的 MySQL 默认值，症状是“配了 Kingbase 却连 3306”。
DATABASE_URL='jdbc:kingbase8://127.0.0.1:54321/maxkey?characterEncoding=UTF-8&useUnicode=true'
DATABASE_USER=maxkey
# 数据库口令**不写入本文件**，由运行环境注入，本行只做“继承”：
# 外部已注入则保留原值，未注入则为空。
#
# 注入方式（任选其一）：
#   a) systemd 独立密钥文件（推荐）
#        在 maxkey-portal.service / maxkey-mgt.service 的 [Service] 段加：
#            EnvironmentFile=-/etc/maxkey/maxkey-secret.env
#        密钥文件权限 600 root:root，内容仅一行：
#            DATABASE_PWD='实际口令'
#   b) systemd 直接内联
#        Environment="DATABASE_PWD=实际口令"
#        单元文件本身需 chmod 600，否则口令对所有用户可读
#   c) 手工启动
#        export DATABASE_PWD='实际口令' && ./bin/maxkeyctl.sh start
#
# ⚠️ 未注入时本行为空串。实测（Spring 7 PropertyPlaceholderHelper）：
#    变量**不存在**时才回落默认值；变量存在但为**空串**时，占位符
#    ${DATABASE_PWD:maxkey} 解析结果就是空串，**不会**回落成 maxkey。
#    即空口令会直接连库失败（password authentication failed），
#    而不是"悄悄用了默认口令"。
#    为避免这种难查的失败，maxkeyctl.sh 在启动前会显式校验并拒绝启动。
DATABASE_PWD="${DATABASE_PWD:-}"

# 方言: kingbase / mysql / postgresql
DATABASE_DIALECT=kingbase

# KingbaseES 在 MySQL 兼容模式下 online 为保留字，必须用双引号转义标识符
# MySQL 部署时保持 false 与反引号
DATABASE_COLUMN_ESCAPE=true
# 注意：这里必须是“一个双引号”字符本身。用单引号包裹，否则裸双引号会让
# 整个 env 文件 source 失败（shell 会报 unexpected EOF），且不报错退出。
DATABASE_COLUMN_ESCAPE_CHAR='"'

# ------------------------------------------------------------------- JVM --
JAVA_OPTS_PORTAL="-Xms512m -Xmx2048m"
JAVA_OPTS_MGT="-Xms256m -Xmx1024m"

# ------------------------------------------------------------- 登录/安全 --
# 内网首次联调可关验证码，生产环境建议 true
LOGIN_CAPTCHA=true
# TOTP 二次认证，无短信/邮箱通道时建议 false
LOGIN_MFA_ENABLED=false
# 会话超时（秒）
SERVLET_SESSION_TIMEOUT=1800

# --------------------------------------------------------------- 运行控制 --
# 启动等待端口就绪的最长秒数
START_TIMEOUT=180
# nohup 日志保留天数
LOG_KEEP_DAYS=30
