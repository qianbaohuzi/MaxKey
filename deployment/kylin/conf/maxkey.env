############################################################################
#  MaxKey 部署环境变量（麒麟 / 通用 Linux）
#
#  放置位置: <发布根>/conf/maxkey.env
#  由 bin/maxkeyctl.sh 自动 source；systemd 单元会显式指定该文件。
#
#  说明:
#    * Spring Boot 的属性占位符形如 ${DATABASE_PWD:maxkey}，
#      这里的 shell 变量会被同名环境变量覆盖，优先顺序为：
#          shell 环境变量 > 本文件 > 代码内默认值
#    * 修改本文件后需 restart 生效
############################################################################

# ------------------------------------------------------------------ 基本 --
# 站点域名。只写主域部分，不要写 http:// 或端口。
# 主域名。程序内部拼成 sso.<SERVER_DOMAIN>（见 application-maxkey.properties）。
# 该域名同时用于三件事，必须与 nginx 的 server_name 一致：
#   ① 租户识别（WebInstRequestFilter 按 Host 头查机构）
#   ② SSO 回跳地址
#   ③ Cookie 域
SERVER_DOMAIN=example.gov.cn

# 对外暴露的协议。决定 maxkey.server.scheme，
# 也用于 MAXKEY_PUBLIC_URL 未配置时的默认推导。
MAXKEY_SCHEME=https

# ------------------------------------------------- 对外访问地址（必读） ----
# 浏览器实际访问 MaxKey 的根地址：**不含** context-path，**不带**末尾斜杠。
#
# 这是整套配置里唯一需要改的"地址类"项，它决定：
#   1. JWT 的 iss 声明 —— 签发与校验用同一个固定值，不做请求推导
#      （JwtLoginService 对 iss 做严格相等比对，不一致的 token 直接判无效）
#   2. 登录后跳转的登录页 / 门户地址
#   3. OAuth2 授权确认页、登出回跳地址
#
# 按对外入口填写：
#   nginx 上 443 + https   →  https://sso.example.gov.cn
#   nginx 上 80  + http    →  http://sso.example.gov.cn
#   非标端口（如 9443）    →  https://sso.example.gov.cn:9443
#
# 留空则按 SERVER_DOMAIN 推导为 ${MAXKEY_SCHEME}://sso.${SERVER_DOMAIN}；
# 但**只要对外端口不是 scheme 的默认端口就必须显式填写**，否则 iss 会缺端口，
# 表现为"登录成功后立刻被踢回登录页"。
#
# 注意：OIDC 元数据里的 issuer 不读这一项，而是由 nginx 传的
# X-Forwarded-Proto/Port + 后端 server.forward-headers-strategy=NATIVE 推导。
# 两者必须指向同一地址，否则客户端按元数据校验 token 会失败。
MAXKEY_PUBLIC_URL=https://sso.example.gov.cn

# ------------------------------------------------------------------ 端口 --
# 后端 HTTP 端口（只监听本机，由 nginx 反代）
PORTAL_PORT=9527
MGT_PORT=9526

# ------------------------------------------------------ 前端与 nginx ----
# 前端静态资源在 URL 上的前缀，必须与 maxkey-web-ng 的 build --base-href 一致
MAXKEY_FRONTEND_URI=/maxkey

# nginx 上 MaxKey 站点的 server_name 与 TLS 端口。
# install.sh 用这几项渲染 nginx/maxkey-site.conf；必须与 MAXKEY_PUBLIC_URL 一致，
# 不一致会在安装阶段被显式拦下（那种不一致必然导致 SSO 回跳失败）。
#
# 端口选择注意：
#   443 是标准端口，URL 里可以不带端口。但很多环境 443 已被占用，
#   尤其是 WSL 下 Windows 侧的端口转发 —— 此时 Linux 里 `ss -lntp` 看不到
#   占用者，nginx 却会 bind() 失败。遇到这种情况换一个端口即可，
#   例如 9443，并把 MAXKEY_PUBLIC_URL 同步改成带端口的形式。
#   install.sh 会在写入配置前预检端口，并在 reload 后校验端口确实监听，
#   失败自动回滚，不会把 nginx 带挂。
NGINX_SERVER_NAME=sso.example.gov.cn
NGINX_TLS_PORT=443
NGINX_CERT=/etc/nginx/cert/sso.example.gov.cn.crt
NGINX_KEY=/etc/nginx/cert/sso.example.gov.cn.key

# ----------------------------------------------------------------- 数据库 --
# 驱动: com.kingbase8.Driver / com.mysql.cj.jdbc.Driver
DATABASE_DRIVER=com.kingbase8.Driver
# 注意：JDBC URL 含 & 和 ?，**必须用单引号包裹**。
# 裸写会让 bash 把 & 当成“后台执行”分隔符，DATABASE_URL 变成空值，
# 后面的 useUnicode=true 被当成命令执行（报 command not found），
# 最终应用静默回落到内置的 MySQL 默认值，症状是“配了 Kingbase 却连 3306”。
DATABASE_URL='jdbc:kingbase8://127.0.0.1:54321/maxkey?characterEncoding=UTF-8&useUnicode=true'
DATABASE_USER=maxkey
# 数据库口令**不写入本文件**，由运行环境注入，本行只做“继承”：
# 外部已注入则保留原值，未注入则为空。
#
# 注入方式（任选其一）：
#   a) systemd 独立密钥文件（推荐）
#        在 maxkey-portal.service / maxkey-mgt.service 的 [Service] 段加：
#            EnvironmentFile=-/etc/maxkey/maxkey-secret.env
#        密钥文件权限 600 root:root，内容仅一行：
#            DATABASE_PWD='实际口令'
#   b) systemd 直接内联
#        Environment="DATABASE_PWD=实际口令"
#        单元文件本身需 chmod 600，否则口令对所有用户可读
#   c) 手工启动
#        export DATABASE_PWD='实际口令' && ./bin/maxkeyctl.sh start
#
# ⚠️ 未注入时本行为空串。实测（Spring 7 PropertyPlaceholderHelper）：
#    变量**不存在**时才回落默认值；变量存在但为**空串**时，占位符
#    ${DATABASE_PWD:maxkey} 解析结果就是空串，**不会**回落成 maxkey。
#    即空口令会直接连库失败（password authentication failed），
#    而不是"悄悄用了默认口令"。
#    为避免这种难查的失败，maxkeyctl.sh 在启动前会显式校验并拒绝启动。
DATABASE_PWD="${DATABASE_PWD:-}"

# ------------------------------------------------------------- JWT 密钥 ----
# 4.2.0 起，JWT 的 HMAC 密钥**不再写死在代码里**，改为环境变量注入：
#
#   maxkey.auth.jwt.secret          = ${JWT_SECRET}
#   maxkey.auth.jwt.refresh.secret  = ${JWT_SECRET}
#
# 为什么改：原先这两项是 512 字符的明文常量，写在
# application-maxkey.properties 与 application-maxkey-mgt.properties 里，
# 任何人 unzip 交付的 jar 就能拿到它，进而伪造任意用户的 token。
#
# 两条硬约束：
#   1. **portal 与 mgt 必须用同一个值**。两边签发的 token 互不认可时，
#      症状是"登录成功但立刻被踢回登录页"。
#   2. **长度必须 >= 64 字节**（HS512 的密钥下限），否则启动时抛
#      WeakKeyException。install.sh 生成的默认值就是 512 个字符。
#
# 值放在 /etc/maxkey/maxkey-secret.env（600 root:root），与 DATABASE_PWD 同处：
#     JWT_SECRET='<512 字符随机串>'
#
# 本行只做"继承"：外部（systemd EnvironmentFile 或手工 export）注入才有值。
# 改这个值会让**所有已登录会话立即失效**，换环境时才需要改。
JWT_SECRET="${JWT_SECRET:-}"

# 方言: kingbase / mysql / postgresql
DATABASE_DIALECT=kingbase

# KingbaseES 在 MySQL 兼容模式下 online 为保留字，必须用双引号转义标识符
# MySQL 部署时保持 false 与反引号
DATABASE_COLUMN_ESCAPE=true
# 注意：这里必须是“一个双引号”字符本身。用单引号包裹，否则裸双引号会让
# 整个 env 文件 source 失败（shell 会报 unexpected EOF），且不报错退出。
DATABASE_COLUMN_ESCAPE_CHAR='"'

# ------------------------------------------------------------------- JVM --
JAVA_OPTS_PORTAL="-Xms512m -Xmx2048m"
JAVA_OPTS_MGT="-Xms256m -Xmx1024m"

# ------------------------------------------------------------- 登录/安全 --
# 内网首次联调可关验证码，生产环境建议 true
LOGIN_CAPTCHA=true
# TOTP 二次认证，无短信/邮箱通道时建议 false
LOGIN_MFA_ENABLED=false
# 会话超时（秒）
SERVLET_SESSION_TIMEOUT=1800

# --------------------------------------------------- 管理端免密登录 (CAS) --
# 门户菜单「后台」跳到 /sign/authz/maxkey_mgt，走 CAS 换 ticket，
# 再由管理端 /login/trust 校验 ticket 换取登录态。
#
# 这里有两个**不同**的地址，别混：
#
#   LOGIN_CAS_SERVER  管理端去哪个地址**校验** ticket（CAS 服务端前缀）
#   LOGIN_CAS_SERVICE 管理端自己声明的 service，必须与数据库里
#                     mxk_apps_cas_details.service **完全相等**
#
# 为什么 SERVER 走本机回环而不是对外地址：
#   默认值 http://sso.maxkey.top/sign/authz/cas 是公网演示环境，
#   现场不改就会把 ticket 发到外网演示服务器（点「后台」卡住或跳回登录页）。
#   改用对外 HTTPS 地址同样不行：现场证书多为自签，JVM 的 cacerts 里没有它，
#   cas-client 用 HttpURLConnection 直连会抛
#       SSLHandshakeException: PKIX path building failed
#   实测确认过（java.net.URL 直接访问 9443 即失败）。
#   因此校验走后端本机 HTTP 端口（后端 context-path 是 /sign，不经 nginx）。
#
# 为什么 SERVICE 必须是对外 HTTPS：
#   ticket 是绑定 service 签发的，serviceValidate 时会拿它和
#   mxk_apps_cas_details.service 做字符串严格相等比对。写 127.0.0.1
#   就会因不一致被判 INVALID_SERVICE。换域名时必须同步改库里的那三行。
#
# 注意 service 必须带 hash 路由：管理端前端是 useHash:true，
# ticket 只有落在 #/ 之后才能被 TrustAuthComponent 从 queryParams 读到。
LOGIN_CAS_SERVER="http://127.0.0.1:${PORTAL_PORT:-9527}/sign/authz/cas"
LOGIN_CAS_SERVICE="${MAXKEY_PUBLIC_URL}/maxkey-mgt/#/passport/trust/auth"

# --------------------------------------------------------------- 运行控制 --
# 启动等待端口就绪的最长秒数
START_TIMEOUT=180
# nohup 日志保留天数
LOG_KEEP_DAYS=30
