############################################################################
#  环境档案：qilin01
#
#  目标机：qilin-01（麒麟 V10，KingbaseES V9 本机 54321）
#  域名  ：sso.maxkey.lottery-dev.com（需内网 DNS A 记录 → qilin-01 IP）
#  端口  ：9443（443 备用；80 已被 box-admin 站点占用，不要用）
#
#  本档案只含「这台机器与别人不同的项」，不含任何口令。
#  口令在目标机 /etc/maxkey/maxkey-secret.env，由 install.sh 生成或运维预置。
#
#  用法：sudo ./install.sh --profile qilin01
############################################################################

# ---------------------------------------------------------------- 域名 --
# 主域名。程序内部拼成 sso.<SERVER_DOMAIN> 用于租户识别/Cookie 域。
# ⚠️ 必须与 NGINX_SERVER_NAME 一致，install.sh 会校验。
SERVER_DOMAIN=maxkey.lottery-dev.com

# 浏览器实际访问的根地址：不含 context-path、不带末尾斜杠、端口必须显式写。
# 这是整套配置里唯一需要改的"地址类"项，决定 JWT 的 iss 与所有回跳地址。
MAXKEY_PUBLIC_URL=https://sso.maxkey.lottery-dev.com:9443

# ------------------------------------------------------------ nginx/证书 --
# 自签证书放这里；生成命令见 OPERATIONS.md 第 3.2 节。
NGINX_SERVER_NAME=sso.maxkey.lottery-dev.com
NGINX_TLS_PORT=9443
NGINX_CERT=/etc/nginx/cert/sso.maxkey.lottery-dev.com.crt
NGINX_KEY=/etc/nginx/cert/sso.maxkey.lottery-dev.com.key

# ------------------------------------------------------------ 数据库 --
# qilin-01 本机 KingbaseES V9（54321）。库与角色由 DBA 预先建好。
# 注意 URL 含 & 必须用单引号包裹，否则会被 shell 截断。
DATABASE_DRIVER=com.kingbase8.Driver
DATABASE_URL='jdbc:kingbase8://127.0.0.1:54321/maxkey?characterEncoding=UTF-8&useUnicode=true'
DATABASE_USER=maxkey
DATABASE_DIALECT=kingbase
DATABASE_COLUMN_ESCAPE=true

# ------------------------------------------------------------ 端口/前端 --
PORTAL_PORT=9527
MGT_PORT=9526
MAXKEY_FRONTEND_URI=/maxkey

# ------------------------------------------------------------ 登录策略 --
# 测试环境：验证码开着（生产口径），点测时按图片输入即可。
LOGIN_CAPTCHA=true
LOGIN_MFA_ENABLED=false
