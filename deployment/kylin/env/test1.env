############################################################################
#  环境档案：test1（新测试服务器占位）
#
#  这是「切换环境」的样板：与 dev-local 的差异只有 4 组 —— 域名、证书、
#  数据库地址、端口。装到新机器时：
#      1. cp 本文件 <新环境名>.env
#      2. 改这 4 组值（证书要从旧机器 scp 到 /etc/nginx/cert/）
#      3. ./install.sh --profile <新环境名>
#
#  ⚠️ 下面全是占位值，install.sh 会因 example.gov.cn 直接拒绝安装 ——
#     这是刻意的，避免"忘了改域名就装上去"。
############################################################################

SERVER_DOMAIN=example.gov.cn
MAXKEY_PUBLIC_URL=https://sso.example.gov.cn

NGINX_SERVER_NAME=sso.example.gov.cn
NGINX_TLS_PORT=443
NGINX_CERT=/etc/nginx/cert/sso.example.gov.cn.crt
NGINX_KEY=/etc/nginx/cert/sso.example.gov.cn.key

# 测试服务器上的 Kingbase 地址（不要照抄本机的 127.0.0.1）
DATABASE_DRIVER=com.kingbase8.Driver
DATABASE_URL='jdbc:kingbase8://10.0.0.11:54321/maxkey?characterEncoding=UTF-8&useUnicode=true'
DATABASE_USER=maxkey
DATABASE_DIALECT=kingbase
DATABASE_COLUMN_ESCAPE=true

PORTAL_PORT=9527
MGT_PORT=9526
MAXKEY_FRONTEND_URI=/maxkey

LOGIN_CAPTCHA=true
LOGIN_MFA_ENABLED=false
