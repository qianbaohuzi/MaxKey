############################################################################
#  环境档案：dev-local
#
#  「切环境要改什么」集中在这里 —— 只有这台机器与别人不同的项。
#  不含任何口令（口令只在 /etc/maxkey/maxkey-secret.env）。
#
#  用法：
#      ./install.sh --profile dev-local
#  由 install.sh 把本文件覆盖到 conf/maxkey.env 模板的同名项上，
#  未列出的项取模板默认值（模板里有逐项注释，现场可继续手改）。
#
#  新增一个环境：cp dev-local.env <新环境>.env，改下面四处即可。
############################################################################

# ---------------------------------------------------------------- 域名 --
# 主域名（程序内部拼成 sso.<SERVER_DOMAIN> 用于租户识别/Cookie 域）
SERVER_DOMAIN=lottery-dev.com

# 浏览器实际访问的根地址：不含 context-path、不带末尾斜杠、端口必须显式写
MAXKEY_PUBLIC_URL=https://sso.lottery-dev.com:9443

# ------------------------------------------------------------ nginx/证书 --
NGINX_SERVER_NAME=sso.lottery-dev.com
NGINX_TLS_PORT=9443
NGINX_CERT=/etc/nginx/cert/sso.lottery-dev.com.crt
NGINX_KEY=/etc/nginx/cert/sso.lottery-dev.com.key

# ------------------------------------------------------------ 数据库 --
# 本机 Kingbase V9（54321）。注意 URL 含 & 必须用单引号包裹。
DATABASE_DRIVER=com.kingbase8.Driver
DATABASE_URL='jdbc:kingbase8://127.0.0.1:54321/maxkey?characterEncoding=UTF-8&useUnicode=true'
DATABASE_USER=maxkey
DATABASE_DIALECT=kingbase
DATABASE_COLUMN_ESCAPE=true

# ------------------------------------------------------------ 端口/前端 --
PORTAL_PORT=9527
MGT_PORT=9526
MAXKEY_FRONTEND_URI=/maxkey

# ------------------------------------------------------------ 登录策略 --
# 内网联调关掉验证码，方便自动化健康检查；生产请改回 true
LOGIN_CAPTCHA=false
LOGIN_MFA_ENABLED=false
